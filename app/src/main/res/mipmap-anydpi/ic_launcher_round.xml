<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background" />
  <foreground android:drawable="@drawable/ic_launcher_foreground" />
  <!--
    No <monochrome>. A themed icon is tinted flat, and the two blues are what hold the S apart from
    the O; drop them and the overlap is one blob. Rather than draw a second, weaker lockup for that
    case, the launcher falls back to the colour icon when themed icons are switched on.
  -->
</adaptive-icon>
